---
// Shown when a visitor arrives via ?utm_source=chatgpt / openai (ChatGPT itself
// appends utm_source=chatgpt.com to links it cites). transition:persist keeps the
// revealed banner across ClientRouter navigations, after the query param is gone.
---

<aside id="utm-banner" class="utm-banner" role="note" hidden transition:persist="utm-banner">
  <p>Grrr, Chatgpt.. Why 3:</p>
</aside>

<script is:inline>
  (() => {
    const source = (new URLSearchParams(location.search).get('utm_source') || '').toLowerCase();
    const sources = ['chatgpt', 'chatgpt.com', 'openai', 'openai.com'];
    // Only ever reveal: later navigations have no param and must not re-hide it.
    if (sources.includes(source)) {
      const banner = document.getElementById('utm-banner');
      if (banner) banner.hidden = false;
    }
  })();
</script>

<style>
  .utm-banner {
    background: color-mix(in oklab, var(--color-accent) 14%, var(--color-bg));
    border-bottom: 1px solid color-mix(in oklab, var(--color-accent) 35%, var(--color-border));
    color: var(--color-text);
    font-size: 0.875rem;
  }
  .utm-banner[hidden] {
    display: none;
  }
  p {
    max-width: 880px;
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
    text-align: center;
  }
</style>
