---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, type ProjectStatus } from '../data/projects';

// Each section collects one or more statuses. Cards still show their own
// status, so the dead pile keeps the abandoned/inactive/discontinued nuance.
const sections: { id: string; title: string; statuses: ProjectStatus[]; blurb: string }[] = [
  {
    id: 'works',
    title: 'stuff that works',
    statuses: ['active'],
    blurb: 'Things I actively maintain or am building right now.',
  },
  {
    id: 'wip',
    title: 'WIP',
    statuses: ['wip'],
    blurb: 'Still being built.',
  },
  {
    id: 'semiactive',
    title: 'Semi-active',
    statuses: ['semi-active'],
    blurb: 'Alive, but only sometimes.',
  },
  {
    id: 'silly',
    title: 'Random and Silly',
    statuses: ['random and silly'],
    blurb: 'Jokes, dares, vibecoded one-off nonsense.',
  },
  {
    id: 'rip',
    title: 'Old and abandonned, rip',
    statuses: ['old and abandonned, rip', 'no longer active', 'discontinued'],
    blurb: 'Abandoned, inactive, shut down or replaced. Left as-is for the museum.',
  },
];

// Empty sections are skipped entirely.
const grouped = sections
  .map((s) => ({ ...s, items: projects.filter((p) => s.statuses.includes(p.status)) }))
  .filter((s) => s.items.length > 0);
---

<BaseLayout
  title="Projects"
  description="Everything I've made, sorted by how alive it still is."
>
  <SectionHeading level="h1" eyebrow="projects">Things I've made</SectionHeading>
  <p class="lede" data-i18n>
    Sorted by how alive they still are.
  </p>

  <nav class="jumps" aria-label="section jumps" data-i18n-attr="aria-label">
    {grouped.map((s) => (
      <a href={`#${s.id}`} class={`jump status-${s.id}`}>
        <span class="jump-title" data-i18n>{s.title}</span>
        <span class="jump-count">{s.items.length}</span>
      </a>
    ))}
  </nav>

  {grouped.map((s) => (
    <section class={`group status-${s.id}`} id={s.id}>
      <div class="group-head">
        <SectionHeading eyebrow={`section`}>
          {s.title}
          <span class="count">{s.items.length}</span>
        </SectionHeading>
      </div>
      <p class="blurb" data-i18n>{s.blurb}</p>
      <div class="grid">
        {s.items.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .lede {
    color: var(--color-muted);
    margin: -0.5rem 0 1.25rem;
  }
  .jumps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .jump {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text);
    background: color-mix(in oklab, var(--color-bg) 92%, var(--color-border));
    transition: border-color 0.2s, transform 0.2s;
  }
  .jump:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .jump-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .jump-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-border) 70%, transparent);
    color: var(--color-muted);
  }
  .jump.status-works .jump-count {
    background: color-mix(in oklab, var(--color-accent) 25%, transparent);
    color: var(--color-accent);
  }
  .jump.status-silly {
    border-style: dashed;
  }
  .jump.status-rip {
    opacity: 0.7;
  }

  .blurb {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: -0.5rem 0 1rem;
  }
  .group {
    margin-bottom: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .count {
    display: inline-block;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-border) 70%, transparent);
    vertical-align: middle;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>
