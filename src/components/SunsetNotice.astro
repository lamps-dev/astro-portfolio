---
import { Icon } from 'astro-icon/components';
import { SUNSET_POST_URL } from '../consts';
---

<aside class="sunset" role="note">
  <p>
    <Icon name="lucide:triangle-alert" width={16} height={16} aria-hidden="true" />
    <span>
      This portfolio will disappear from lamps-dev.dev in February 2027.
      <a href={SUNSET_POST_URL}>Read why</a>
    </span>
  </p>
</aside>

<style>
  .sunset {
    background: color-mix(in oklab, var(--color-accent) 14%, var(--color-bg));
    border-bottom: 1px solid color-mix(in oklab, var(--color-accent) 35%, var(--color-border));
    color: var(--color-text);
    font-size: 0.875rem;
  }
  p {
    max-width: 880px;
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }
  p :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }
  a {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: 0.25rem;
  }
</style>
